<div class="customer section-padding">
  <div class="page-width page-width--narrow">
    <h1 class="h3">{{ 'customer.reset_password.title' | t }}</h1>
    <p>{{ 'customer.reset_password.subtext' | t }}</p>

    {%- form 'reset_customer_password' -%}
      {{ form.errors | default_errors }}
      <div class="field">
        <label class="form__label" for="ResetPassword">{{ 'customer.reset_password.password' | t }}</label>
        <input class="input" type="password" name="customer[password]" id="ResetPassword" autocomplete="new-password" required>
      </div>
      <div class="field">
        <label class="form__label" for="ResetPasswordConfirm">{{ 'customer.reset_password.password_confirm' | t }}</label>
        <input class="input" type="password" name="customer[password_confirmation]" id="ResetPasswordConfirm" autocomplete="new-password" required>
      </div>
      <button type="submit" class="button button--primary">{{ 'customer.reset_password.submit' | t }}</button>
    {%- endform -%}
  </div>
</div>
