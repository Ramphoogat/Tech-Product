<div class="customer section-padding">
  <div class="page-width page-width--narrow">
    <h1 class="h3">{{ 'customer.activate_account.title' | t }}</h1>
    <p>{{ 'customer.activate_account.subtext' | t }}</p>

    {%- form 'activate_customer_password' -%}
      {{ form.errors | default_errors }}
      <div class="field">
        <label class="form__label" for="ActivatePassword">{{ 'customer.activate_account.password' | t }}</label>
        <input class="input" type="password" name="customer[password]" id="ActivatePassword" autocomplete="new-password" required>
      </div>
      <div class="field">
        <label class="form__label" for="ActivatePasswordConfirm">{{ 'customer.activate_account.password_confirm' | t }}</label>
        <input class="input" type="password" name="customer[password_confirmation]" id="ActivatePasswordConfirm" autocomplete="new-password" required>
      </div>
      <button type="submit" class="button button--primary">{{ 'customer.activate_account.submit' | t }}</button>
      <button type="submit" name="decline" class="button button--secondary">{{ 'customer.activate_account.cancel' | t }}</button>
    {%- endform -%}
  </div>
</div>
