<div class="customer section-padding">
  <div class="page-width">
    <h1 class="h3">{{ 'customer.order.title' | t: name: order.name }}</h1>
    <p class="caption">{{ 'customer.order.date_html' | t: date: order.created_at | date: format: 'date' }}</p>

    {%- if order.cancelled -%}
      <p class="form__message" role="status">
        {{ 'customer.order.cancelled_html' | t: date: order.cancelled_at | date: format: 'date' }}
        {{ 'customer.order.cancelled_reason' | t: reason: order.cancel_reason_label }}
      </p>
    {%- endif -%}

    <table class="customer-table">
      <caption class="visually-hidden">{{ 'customer.order.title' | t: name: order.name }}</caption>
      <thead>
        <tr>
          <th scope="col">{{ 'customer.order.product' | t }}</th>
          <th scope="col">{{ 'customer.order.sku' | t }}</th>
          <th scope="col">{{ 'customer.order.price' | t }}</th>
          <th scope="col">{{ 'customer.order.quantity' | t }}</th>
          <th scope="col">{{ 'customer.order.total' | t }}</th>
        </tr>
      </thead>
      <tbody>
        {%- for line_item in order.line_items -%}
          <tr>
            <td>
              <a href="{{ line_item.product.url }}" class="link">{{ line_item.title }}</a>
              {%- if line_item.fulfillment -%}
                <p class="caption">
                  {{ 'customer.order.fulfilled_at' | t: date: line_item.fulfillment.created_at | date: format: 'date' }}
                  {%- if line_item.fulfillment.tracking_url -%}
                    <a href="{{ line_item.fulfillment.tracking_url }}" class="link">{{ 'customer.order.track_shipment' | t }}</a>
                  {%- endif -%}
                </p>
              {%- endif -%}
            </td>
            <td>{{ line_item.sku }}</td>
            <td>{{ line_item.final_price | money }}</td>
            <td>{{ line_item.quantity }}</td>
            <td>{{ line_item.final_line_price | money }}</td>
          </tr>
        {%- endfor -%}
      </tbody>
      <tfoot>
        <tr>
          <th scope="row" colspan="4">{{ 'customer.order.subtotal' | t }}</th>
          <td>{{ order.line_items_subtotal_price | money }}</td>
        </tr>
        {%- for shipping_method in order.shipping_methods -%}
          <tr>
            <th scope="row" colspan="4">{{ 'customer.order.shipping' | t }} ({{ shipping_method.title }})</th>
            <td>{{ shipping_method.price | money }}</td>
          </tr>
        {%- endfor -%}
        {%- for tax_line in order.tax_lines -%}
          <tr>
            <th scope="row" colspan="4">{{ 'customer.order.tax' | t }} ({{ tax_line.title }})</th>
            <td>{{ tax_line.price | money }}</td>
          </tr>
        {%- endfor -%}
        <tr>
          <th scope="row" colspan="4">{{ 'customer.order.total' | t }}</th>
          <td>{{ order.total_price | money_with_currency }}</td>
        </tr>
      </tfoot>
    </table>

    <div class="customer__addresses">
      <section>
        <h2 class="h6">{{ 'customer.order.billing_address' | t }}</h2>
        <p class="caption">{{ 'customer.order.payment_status' | t }}: {{ order.financial_status_label }}</p>
        {{ order.billing_address | format_address }}
      </section>
      <section>
        <h2 class="h6">{{ 'customer.order.shipping_address' | t }}</h2>
        <p class="caption">{{ 'customer.order.fulfillment_status' | t }}: {{ order.fulfillment_status_label }}</p>
        {{ order.shipping_address | format_address }}
      </section>
    </div>

    <a href="{{ routes.account_url }}" class="link">{{ 'customer.account.return' | t }}</a>
  </div>
</div>
