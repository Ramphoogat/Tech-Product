{%- unless cart == empty -%}
  <div class="cart-footer section-padding section-frame" style="{% render 'section-style' %}">
    <div class="page-width cart-footer__inner">
      {%- if settings.cart_show_note -%}
        <div class="cart-footer__note">
          <label class="form__label" for="CartNote">{{ 'sections.cart.note' | t }}</label>
          <textarea
            id="CartNote"
            class="input"
            name="note"
            form="CartPageForm"
            rows="4"
            placeholder="{{ 'sections.cart.note_placeholder' | t | escape }}"
          >{{ cart.note }}</textarea>
        </div>
      {%- endif -%}

      <div class="cart-footer__summary">
        <h2 class="h5">{{ 'sections.cart.order_summary' | t }}</h2>

        {% render 'free-shipping-bar' %}

        {%- if cart.cart_level_discount_applications.size > 0 -%}
          <ul class="cart-footer__discounts caption" role="list">
            {%- for discount in cart.cart_level_discount_applications -%}
              <li>{{ discount.title }} (-{{ discount.total_allocated_amount | money }})</li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        <div class="cart-footer__totals">
          <span class="h6">{{ 'sections.cart.estimated_total' | t }}</span>
          <span class="h4">
            {%- if settings.currency_code_enabled -%}
              {{ cart.total_price | money_with_currency }}
            {%- else -%}
              {{ cart.total_price | money }}
            {%- endif -%}
          </span>
        </div>

        {% render 'tax-shipping-note' %}

        <button type="submit" name="checkout" form="CartPageForm" class="button button--primary button--full">
          {{- 'sections.cart.checkout' | t -}}
        </button>

        {%- if section.settings.show_login_prompt and shop.customer_accounts_enabled and customer == nil -%}
          <p class="cart-footer__login caption">
            {{ 'sections.cart.login.title' | t }}
            {{ 'sections.cart.login.paragraph_html' | t: link: routes.account_login_url }}
          </p>
        {%- endif -%}
      </div>
    </div>
  </div>
{%- endunless -%}

{% schema %}
{
  "name": "Cart footer",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Section style"
    },
    {
      "type": "color",
      "id": "section_background",
      "label": "Background color",
      "info": "Leave blank to use the color scheme background."
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top margin",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom margin",
      "default": 0
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "default": "page",
      "options": [
        {
          "value": "page",
          "label": "Contained"
        },
        {
          "value": "wide",
          "label": "Wide"
        },
        {
          "value": "full",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "range",
      "id": "section_min_height",
      "min": 0,
      "max": 800,
      "step": 20,
      "unit": "px",
      "label": "Minimum height",
      "default": 0,
      "info": "0 uses the content's natural height."
    },
    {
      "type": "range",
      "id": "section_corner_radius",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Corner radius",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "show_login_prompt",
      "label": "Show log in prompt",
      "default": true
    }
  ]
}
{% endschema %}
