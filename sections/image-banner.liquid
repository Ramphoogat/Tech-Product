{{ 'section-image-banner.css' | asset_url | stylesheet_tag }}

<div class="image-banner image-banner--{{ section.settings.height }} color-{{ section.settings.color_scheme }}">
  {%- if section.settings.image != blank -%}
    <div class="image-banner__media">
      {% render 'responsive-image',
        image: section.settings.image,
        sizes: '100vw',
        loading: 'eager',
        fetchpriority: 'high',
        class: 'image-banner__image'
      %}
    </div>
    <div class="image-banner__overlay" style="--overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"></div>
  {%- else -%}
    <div class="image-banner__media image-banner__media--placeholder">
      {% render 'placeholder-hero' %}
    </div>
  {%- endif -%}

  <div class="page-width image-banner__content image-banner__content--{{ section.settings.content_alignment }}">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'heading' -%}
          <h2 class="image-banner__heading h1" {{ block.shopify_attributes }}>{{ block.settings.heading }}</h2>
        {%- when 'text' -%}
          <div class="image-banner__text rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
        {%- when 'buttons' -%}
          <div class="image-banner__buttons" {{ block.shopify_attributes }}>
            {%- if block.settings.button_label_1 != blank -%}
              {%- capture banner_href_1 -%}
                {%- render 'localized-url', url: block.settings.button_link_1 -%}
              {%- endcapture -%}
              <a href="{{ banner_href_1 }}" class="button button--primary">
                {{- block.settings.button_label_1 -}}
              </a>
            {%- endif -%}
            {%- if block.settings.button_label_2 != blank -%}
              {%- capture banner_href_2 -%}
                {%- render 'localized-url', url: block.settings.button_link_2 -%}
              {%- endcapture -%}
              <a href="{{ banner_href_2 }}" class="button button--secondary">
                {{- block.settings.button_label_2 -}}
              </a>
            {%- endif -%}
          </div>
      {%- endcase -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Image banner",
  "tag": "section",
  "class": "section",
  "max_blocks": 3,
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    {
      "type": "select",
      "id": "height",
      "label": "Banner height",
      "default": "medium",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ]
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content alignment",
      "default": "start",
      "options": [
        { "value": "start", "label": "Start" },
        { "value": "center", "label": "Center" }
      ]
    },
    { "type": "range", "id": "overlay_opacity", "min": 0, "max": 80, "step": 5, "unit": "%", "label": "Image overlay opacity", "default": 30 },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "inverse",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "subdued", "label": "Subdued" },
        { "value": "inverse", "label": "Inverse" }
      ]
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Heading",
      "limit": 1,
      "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "Built for the way you work" }]
    },
    {
      "type": "text",
      "name": "Text",
      "limit": 1,
      "settings": [{ "type": "richtext", "id": "text", "label": "Text", "default": "<p>Ships worldwide with region-correct power adapters.</p>" }]
    },
    {
      "type": "buttons",
      "name": "Buttons",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "button_label_1", "label": "First button label", "default": "Shop now" },
        { "type": "url", "id": "button_link_1", "label": "First button link" },
        { "type": "text", "id": "button_label_2", "label": "Second button label" },
        { "type": "url", "id": "button_link_2", "label": "Second button link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image banner",
      "blocks": [{ "type": "heading" }, { "type": "text" }, { "type": "buttons" }]
    }
  ]
}
{% endschema %}
