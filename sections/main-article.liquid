<article class="article section-padding section-frame" style="{% render 'section-style' %}">
  <div class="page-width page-width--narrow">
    <header class="article__header">
      <h1 class="h2">{{ article.title | escape }}</h1>
      <p class="caption">
        <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
          {{- article.published_at | date: format: 'date' -}}
        </time>
        {%- if section.settings.show_author and article.author != blank %}
          · {{ 'sections.blog_posts.by_author' | t: author: article.author }}
        {%- endif -%}
      </p>
    </header>

    {%- if article.image and section.settings.show_image -%}
      <div class="article__media">
        {% render 'responsive-image',
          image: article.image,
          sizes: '(min-width: 990px) 900px, 100vw',
          loading: 'eager',
          fetchpriority: 'high',
          class: 'article__image'
        %}
      </div>
    {%- endif -%}

    <div class="article__content rte">{{ article.content }}</div>

    <p class="article__back">
      <a href="{{ blog.url }}" class="link">
        {{- 'sections.article.back_to_blog' | t: title: blog.title -}}
      </a>
    </p>
  </div>
</article>

{% schema %}
{
  "name": "Article",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Section style"
    },
    {
      "type": "color",
      "id": "section_background",
      "label": "Background color",
      "info": "Leave blank to use the color scheme background."
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top margin",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom margin",
      "default": 0
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "default": "page",
      "options": [
        {
          "value": "page",
          "label": "Contained"
        },
        {
          "value": "wide",
          "label": "Wide"
        },
        {
          "value": "full",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "range",
      "id": "section_min_height",
      "min": 0,
      "max": 800,
      "step": 20,
      "unit": "px",
      "label": "Minimum height",
      "default": 0,
      "info": "0 uses the content's natural height."
    },
    {
      "type": "range",
      "id": "section_corner_radius",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Corner radius",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "Show featured image",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "Show author",
      "default": false
    }
  ]
}
{% endschema %}
