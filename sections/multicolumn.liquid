{%- comment -%}
  Icon/image columns. Each column can be limited to a list of countries, which
  is how store-wide promises that are only true in some markets (next-day
  delivery, local warranty depots, duty-free thresholds) stay honest.
{%- endcomment -%}

{{ 'section-multicolumn.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign visible_blocks = ''
  for block in section.blocks
    assign codes = block.settings.countries | remove: ' ' | upcase | split: ','
    if block.settings.countries == blank or codes contains localization.country.iso_code
      assign visible_blocks = visible_blocks | append: block.id | append: ','
    endif
  endfor
  assign visible_ids = visible_blocks | split: ','
-%}

{%- if visible_ids.size > 0 -%}
  <div class="multicolumn section-padding color-{{ section.settings.color_scheme }} section-frame" style="{% render 'section-style' %}">
    <div class="page-width">
      {%- if section.settings.heading != blank -%}
        <div class="section-heading-row">
          <h2 class="h3">{{ section.settings.heading }}</h2>
        </div>
      {%- endif -%}

      <ul
        class="grid multicolumn__grid"
        role="list"
        style="--columns-desktop: {{ section.settings.columns_desktop }}; --columns-mobile: {{ section.settings.columns_mobile }};"
      >
        {%- for block in section.blocks -%}
          {%- if visible_ids contains block.id -%}
            <li class="grid__item multicolumn__item" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
                <div class="multicolumn__media">
                  {% render 'responsive-image',
                    image: block.settings.image,
                    sizes: '(min-width: 990px) 25vw, 50vw',
                    widths: '200,400,600,800'
                  %}
                </div>
              {%- elsif block.settings.icon != 'none' -%}
                <div class="multicolumn__icon">{% render 'icon', icon: block.settings.icon %}</div>
              {%- endif -%}

              {%- if block.settings.heading != blank -%}
                <h3 class="multicolumn__heading h6" style="{% render 'text-style', block: block %}">{{ block.settings.heading }}</h3>
              {%- endif -%}

              <div class="multicolumn__text rte" style="{% render 'text-style', block: block %}">{{ block.settings.text }}</div>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Multicolumn",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Section style"
    },
    {
      "type": "color",
      "id": "section_background",
      "label": "Background color",
      "info": "Leave blank to use the color scheme background."
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top margin",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom margin",
      "default": 0
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "default": "page",
      "options": [
        {
          "value": "page",
          "label": "Contained"
        },
        {
          "value": "wide",
          "label": "Wide"
        },
        {
          "value": "full",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "range",
      "id": "section_min_height",
      "min": 0,
      "max": 800,
      "step": 20,
      "unit": "px",
      "label": "Minimum height",
      "default": 0,
      "info": "0 uses the content's natural height."
    },
    {
      "type": "range",
      "id": "section_corner_radius",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Corner radius",
      "default": 0
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why buy from us"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Columns on desktop",
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "default": "1",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ]
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "subdued",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "subdued",
          "label": "Subdued"
        },
        {
          "value": "inverse",
          "label": "Inverse"
        }
      ]
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "truck",
          "options": [
            {
              "value": "none",
              "label": "None"
            },
            {
              "value": "truck",
              "label": "Delivery"
            },
            {
              "value": "shield",
              "label": "Warranty"
            },
            {
              "value": "plug",
              "label": "Power"
            },
            {
              "value": "refresh",
              "label": "Returns"
            },
            {
              "value": "support",
              "label": "Support"
            },
            {
              "value": "globe",
              "label": "Global"
            }
          ]
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Replaces the icon when set."
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Ships from a local warehouse"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Describe the promise you can actually keep in this market.</p>"
        },
        {
          "type": "text",
          "id": "countries",
          "label": "Show for countries",
          "info": "Comma-separated ISO country codes, for example US, CA. Leave blank to show in every market."
        },
        {
          "type": "header",
          "content": "Text style"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text color",
          "info": "Leave blank to use the section's text color."
        },
        {
          "type": "select",
          "id": "text_size",
          "label": "Text size",
          "default": "default",
          "options": [
            {
              "value": "default",
              "label": "Default"
            },
            {
              "value": "small",
              "label": "Small"
            },
            {
              "value": "large",
              "label": "Large"
            },
            {
              "value": "xlarge",
              "label": "Extra large"
            }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Multicolumn",
      "blocks": [
        {
          "type": "column"
        },
        {
          "type": "column"
        },
        {
          "type": "column"
        },
        {
          "type": "column"
        }
      ]
    }
  ]
}
{% endschema %}
