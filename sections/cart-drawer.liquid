{{ 'component-cart.css' | asset_url | stylesheet_tag }}
<script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>

<cart-drawer class="cart-drawer{% if cart == empty %} cart-drawer--empty{% endif %}" id="CartDrawer">
  <div class="cart-drawer__overlay" data-cart-drawer-close tabindex="-1"></div>

  <div
    class="cart-drawer__panel"
    role="dialog"
    aria-modal="true"
    aria-labelledby="CartDrawerTitle"
    tabindex="-1"
  >
    <div class="cart-drawer__header">
      <h2 class="cart-drawer__title h5" id="CartDrawerTitle">{{ 'sections.cart.drawer_title' | t }}</h2>
      <button
        type="button"
        class="cart-drawer__close"
        data-cart-drawer-close
        aria-label="{{ 'general.accessibility.close' | t | escape }}"
      >
        {% render 'icon', icon: 'close' %}
      </button>
    </div>

    {%- unless cart == empty -%}
      {% render 'free-shipping-bar' %}
    {%- endunless -%}

    {%- if cart == empty -%}
      <div class="cart-drawer__empty">
        <p class="h5">{{ 'sections.cart.empty' | t }}</p>
        <p class="caption">{{ 'sections.cart.empty_text' | t }}</p>
        <a href="{{ routes.all_products_collection_url }}" class="button button--primary">
          {{- 'general.continue_shopping' | t -}}
        </a>
      </div>
    {%- else -%}
      <cart-items class="cart-drawer__body">
        <form action="{{ routes.cart_url }}" method="post" id="CartDrawerForm" novalidate>
          <ul class="cart-items" role="list">
            {%- for item in cart.items -%}
              <li class="cart-item" data-key="{{ item.key }}" data-line="{{ forloop.index }}">
                <a href="{{ item.url }}" class="cart-item__media" tabindex="-1" aria-hidden="true">
                  {%- if item.image -%}
                    {% render 'responsive-image',
                      image: item.image,
                      sizes: '90px',
                      widths: '90,180,270',
                      class: 'cart-item__image'
                    %}
                  {%- endif -%}
                </a>

                <div class="cart-item__details">
                  <a href="{{ item.url }}" class="cart-item__title">{{ item.product.title | escape }}</a>

                  {%- if settings.cart_show_vendor and item.product.vendor != blank -%}
                    <p class="cart-item__vendor caption">{{ item.product.vendor }}</p>
                  {%- endif -%}

                  {%- unless item.product.has_only_default_variant -%}
                    <p class="cart-item__options caption">
                      {%- for option in item.options_with_values -%}
                        {{ option.name }}: {{ option.value }}{% unless forloop.last %} · {% endunless %}
                      {%- endfor -%}
                    </p>
                  {%- endunless -%}

                  {%- if item.selling_plan_allocation -%}
                    <p class="cart-item__options caption">{{ item.selling_plan_allocation.selling_plan.name }}</p>
                  {%- endif -%}

                  {%- if item.line_level_discount_allocations.size > 0 -%}
                    <ul class="cart-item__discounts caption" role="list">
                      {%- for allocation in item.line_level_discount_allocations -%}
                        <li>{{ allocation.discount_application.title }} (-{{ allocation.amount | money }})</li>
                      {%- endfor -%}
                    </ul>
                  {%- endif -%}

                  <div class="cart-item__quantity">
                    {% render 'quantity-input',
                      id: 'CartDrawerQuantity-' | append: forloop.index,
                      name: 'updates[]',
                      value: item.quantity,
                      min: 0,
                      product_title: item.product.title,
                      line_index: forloop.index
                    %}
                    <a
                      href="{{ item.url_to_remove }}"
                      class="cart-item__remove link"
                      data-line="{{ forloop.index }}"
                      aria-label="{{ 'sections.cart.remove_title' | t: title: item.title | escape }}"
                    >
                      {{- 'general.accessibility.remove' | t -}}
                    </a>
                  </div>

                  <p class="cart-item__error caption" role="alert" data-line-error hidden></p>
                </div>

                <div class="cart-item__price">
                  {%- if item.original_line_price != item.final_line_price -%}
                    <s class="caption">{{ item.original_line_price | money }}</s>
                    <span>{{ item.final_line_price | money }}</span>
                  {%- else -%}
                    <span>{{ item.final_line_price | money }}</span>
                  {%- endif -%}
                </div>
              </li>
            {%- endfor -%}
          </ul>

          <noscript>
            <button type="submit" name="update" class="button button--secondary">
              {{- 'sections.cart.update' | t -}}
            </button>
          </noscript>
        </form>
      </cart-items>

      <div class="cart-drawer__footer">
        {%- if settings.cart_show_note -%}
          <details class="accordion">
            <summary class="accordion__summary">
              <span class="accordion__title">{{ 'sections.cart.note' | t }}</span>
              <span class="accordion__marker" aria-hidden="true">
                {% render 'icon', icon: 'chevron-down' %}
              </span>
            </summary>
            <div class="accordion__content">
              <label class="visually-hidden" for="CartDrawerNote">{{ 'sections.cart.note' | t }}</label>
              <textarea
                id="CartDrawerNote"
                class="input"
                name="note"
                form="CartDrawerForm"
                rows="3"
                placeholder="{{ 'sections.cart.note_placeholder' | t | escape }}"
              >{{ cart.note }}</textarea>
            </div>
          </details>
        {%- endif -%}

        {%- if cart.cart_level_discount_applications.size > 0 -%}
          <ul class="cart-drawer__discounts caption" role="list">
            {%- for discount in cart.cart_level_discount_applications -%}
              <li>{{ discount.title }} (-{{ discount.total_allocated_amount | money }})</li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        <div class="cart-drawer__totals">
          <span class="h6">{{ 'sections.cart.estimated_total' | t }}</span>
          <span class="h5">
            {%- if settings.currency_code_enabled -%}
              {{ cart.total_price | money_with_currency }}
            {%- else -%}
              {{ cart.total_price | money }}
            {%- endif -%}
          </span>
        </div>

        {% render 'tax-shipping-note' %}

        <div class="cart-drawer__actions">
          <button type="submit" name="checkout" form="CartDrawerForm" class="button button--primary button--full">
            {{- 'sections.cart.checkout' | t -}}
          </button>
          <a href="{{ routes.cart_url }}" class="button button--secondary button--full">
            {{- 'sections.cart.view_cart' | t -}}
          </a>
        </div>
      </div>
    {%- endif -%}
  </div>
</cart-drawer>

{% schema %}
{
  "name": "Cart drawer",
  "settings": []
}
{% endschema %}
