{{ 'component-card.css' | asset_url | stylesheet_tag }}

<div class="collection-list section-padding color-{{ section.settings.color_scheme }} section-frame" style="{% render 'section-style' %}">
  <div class="page-width">
    <div class="section-heading-row">
      {%- if section.settings.heading != blank -%}
        <h2 class="h3">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.show_view_all -%}
        <a href="{{ routes.collections_url }}" class="link">
          {{- 'sections.collection_list.view_all' | t -}}
        </a>
      {%- endif -%}
    </div>

    <ul
      class="grid"
      role="list"
      style="--columns-desktop: {{ section.settings.columns_desktop }}; --columns-mobile: 2;"
    >
      {%- for block in section.blocks -%}
        {%- assign block_collection = block.settings.collection -%}
        {%- if block_collection != blank -%}
          <li class="grid__item" {{ block.shopify_attributes }}>
            <div class="card card--collection">
              <a href="{{ block_collection.url }}" class="card__media" tabindex="-1" aria-hidden="true">
                {%- if block_collection.featured_image -%}
                  {% render 'responsive-image',
                    image: block_collection.featured_image,
                    sizes: '(min-width: 990px) 25vw, 50vw',
                    class: 'card__image'
                  %}
                {%- else -%}
                  {{ 'collection-1' | placeholder_svg_tag: 'card__image placeholder-svg' }}
                {%- endif -%}
              </a>
              <div class="card__content">
                <h3 class="card__heading h5">
                  <a href="{{ block_collection.url }}" class="card__title-link">
                    {{- block.settings.heading | default: block_collection.title | escape -}}
                  </a>
                </h3>
              </div>
            </div>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Collection list",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Section style"
    },
    {
      "type": "color",
      "id": "section_background",
      "label": "Background color",
      "info": "Leave blank to use the color scheme background."
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top margin",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom margin",
      "default": 0
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "default": "page",
      "options": [
        {
          "value": "page",
          "label": "Contained"
        },
        {
          "value": "wide",
          "label": "Wide"
        },
        {
          "value": "full",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "range",
      "id": "section_min_height",
      "min": 0,
      "max": 800,
      "step": 20,
      "unit": "px",
      "label": "Minimum height",
      "default": 0,
      "info": "0 uses the content's natural height."
    },
    {
      "type": "range",
      "id": "section_corner_radius",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Corner radius",
      "default": 0
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by category"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Columns on desktop",
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show view all link",
      "default": false
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "subdued",
          "label": "Subdued"
        },
        {
          "value": "inverse",
          "label": "Inverse"
        }
      ]
    }
  ],
  "blocks": [
    {
      "type": "featured_collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading override"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection list",
      "blocks": [
        {
          "type": "featured_collection"
        },
        {
          "type": "featured_collection"
        },
        {
          "type": "featured_collection"
        },
        {
          "type": "featured_collection"
        }
      ]
    }
  ]
}
{% endschema %}
