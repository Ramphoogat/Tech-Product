{{ 'component-card.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign show_compare = false
  if settings.enable_compare and section.settings.enable_compare
    assign show_compare = true
  endif
  assign target = section.settings.collection
-%}

<div class="featured-collection section-padding color-{{ section.settings.color_scheme }}">
  <div class="page-width">
    <div class="section-heading-row">
      {%- if section.settings.heading != blank -%}
        <h2 class="h3">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.show_view_all and target != blank -%}
        <a href="{{ target.url }}" class="link">
          {{- 'sections.featured_collection.view_all' | t -}}
        </a>
      {%- endif -%}
    </div>

    {%- if target.products.size > 0 -%}
      <ul
        class="grid product-grid"
        role="list"
        style="--columns-desktop: {{ section.settings.columns_desktop }}; --columns-mobile: {{ section.settings.columns_mobile }};"
      >
        {%- for product in target.products limit: section.settings.products_to_show -%}
          <li class="grid__item">
            {% render 'card-product',
              product: product,
              show_compare: show_compare,
              sizes: '(min-width: 990px) calc(var(--page-width) / 5), (min-width: 750px) 33vw, 50vw'
            %}
          </li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      <p class="caption">{{ 'onboarding.no_content' | t }}</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Featured collection",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "New this season" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "min": 2, "max": 20, "step": 1, "label": "Products to show", "default": 8 },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 5, "step": 1, "label": "Columns on desktop", "default": 4 },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "default": "2",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ]
    },
    { "type": "checkbox", "id": "show_view_all", "label": "Show view all link", "default": true },
    { "type": "checkbox", "id": "enable_compare", "label": "Show compare checkbox on cards", "default": false },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "subdued", "label": "Subdued" },
        { "value": "inverse", "label": "Inverse" }
      ]
    }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
