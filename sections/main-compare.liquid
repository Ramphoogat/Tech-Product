{{ 'component-compare.css' | asset_url | stylesheet_tag }}

<div class="compare-page section-padding section-frame" style="{% render 'section-style' %}">
  <div class="page-width">
    <h1 class="h2">{{ section.settings.heading | default: page.title }}</h1>

    {%- if section.settings.subheading != blank -%}
      <div class="rte">{{ section.settings.subheading }}</div>
    {%- endif -%}

    <compare-table class="compare-table-wrapper">
      <p class="compare-page__status" data-compare-loading hidden>
        {{- 'products.compare.loading' | t -}}
      </p>

      <div class="compare-page__empty" data-compare-empty>
        <p class="h4">{{ 'products.compare.empty_title' | t }}</p>
        <p>{{ 'products.compare.empty_text' | t }}</p>
        {%- if section.settings.browse_link != blank -%}
          {%- capture browse_href -%}
            {%- render 'localized-url', url: section.settings.browse_link -%}
          {%- endcapture -%}
          <a href="{{ browse_href }}" class="button button--primary">
            {{- 'products.compare.add_more' | t -}}
          </a>
        {%- endif -%}
      </div>

      <div class="compare-page__output" data-compare-output></div>
    </compare-table>
  </div>
</div>

{% schema %}
{
  "name": "Product comparison",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Section style"
    },
    {
      "type": "color",
      "id": "section_background",
      "label": "Background color",
      "info": "Leave blank to use the color scheme background."
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top margin",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom margin",
      "default": 0
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "default": "page",
      "options": [
        {
          "value": "page",
          "label": "Contained"
        },
        {
          "value": "wide",
          "label": "Wide"
        },
        {
          "value": "full",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "range",
      "id": "section_min_height",
      "min": 0,
      "max": 800,
      "step": 20,
      "unit": "px",
      "label": "Minimum height",
      "default": 0,
      "info": "0 uses the content's natural height."
    },
    {
      "type": "range",
      "id": "section_corner_radius",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Corner radius",
      "default": 0
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Compare products"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "url",
      "id": "browse_link",
      "label": "Keep shopping link"
    }
  ]
}
{% endschema %}
