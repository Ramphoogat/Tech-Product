{%- comment -%}
  Announcement bar.

  Each message can be limited to a list of countries so a free-shipping
  threshold or a customs notice only shows in the markets where it is
  actually true. With more than one message, the bar can either show them
  all at once (wrapped) or rotate through them one at a time. Visitors can
  optionally dismiss the whole bar for the rest of their session.
{%- endcomment -%}

{{ 'section-announcement-bar.css' | asset_url | stylesheet_tag }}
<script src="{{ 'announcement-bar.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign visible_blocks = ''
  for block in section.blocks
    assign codes = block.settings.countries | remove: ' ' | upcase | split: ','
    if block.settings.countries == blank or codes contains localization.country.iso_code
      assign visible_blocks = visible_blocks | append: block.id | append: ','
    endif
  endfor
  assign visible_ids = visible_blocks | split: ','
  assign visible_count = visible_ids.size

  assign is_rotating = false
  if section.settings.layout == 'rotate' and visible_count > 1
    assign is_rotating = true
  endif
-%}

{%- if visible_count > 0 -%}
  <announcement-bar
    class="announcement-bar color-{{ section.settings.color_scheme }} section-frame"
    style="{% render 'section-style' %}"
    data-section-id="{{ section.id }}"
    data-rotate="{{ is_rotating }}"
    data-interval="{{ section.settings.rotation_speed }}"
    data-dismissible="{{ section.settings.show_dismiss }}"
  >
    <div class="page-width announcement-bar__inner">
      <ul class="announcement-bar__list{% if is_rotating %} announcement-bar__list--rotate{% endif %}" role="list">
        {%- for block in section.blocks -%}
          {%- if visible_ids contains block.id -%}
            <li
              class="announcement-bar__item{% if is_rotating and forloop.first %} is-active{% endif %}"
              style="{% render 'text-style', block: block %}"
              {{ block.shopify_attributes }}
            >
              {%- if block.settings.icon != 'none' -%}
                {% render 'icon', icon: block.settings.icon %}
              {%- endif -%}
              {%- if block.settings.link != blank -%}
                {%- capture announcement_href -%}
                  {%- render 'localized-url', url: block.settings.link -%}
                {%- endcapture -%}
                <a href="{{ announcement_href }}" class="announcement-bar__link">
                  {{- block.settings.text -}}
                </a>
              {%- else -%}
                <span>{{ block.settings.text }}</span>
              {%- endif -%}
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>

      {%- if section.settings.show_localization -%}
        <div class="announcement-bar__localization">
          {% render 'country-language-selector', id_prefix: 'announcement' %}
        </div>
      {%- endif -%}

      {%- if section.settings.show_dismiss -%}
        <button
          type="button"
          class="announcement-bar__dismiss"
          aria-label="{{ 'sections.announcement_bar.dismiss' | t | escape }}"
        >
          {% render 'icon', icon: 'close' %}
        </button>
      {%- endif -%}
    </div>
  </announcement-bar>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "class": "section-announcement-bar",
  "max_blocks": 6,
  "settings": [
    {
      "type": "header",
      "content": "Section style"
    },
    {
      "type": "color",
      "id": "section_background",
      "label": "Background color",
      "info": "Leave blank to use the color scheme background."
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top margin",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom margin",
      "default": 0
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "default": "page",
      "options": [
        { "value": "page", "label": "Contained" },
        { "value": "wide", "label": "Wide" },
        { "value": "full", "label": "Full width" }
      ]
    },
    {
      "type": "range",
      "id": "section_min_height",
      "min": 0,
      "max": 800,
      "step": 20,
      "unit": "px",
      "label": "Minimum height",
      "default": 0,
      "info": "0 uses the content's natural height."
    },
    {
      "type": "range",
      "id": "section_corner_radius",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Corner radius",
      "default": 0
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "inverse",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "subdued", "label": "Subdued" },
        { "value": "inverse", "label": "Inverse" },
        { "value": "accent", "label": "Accent" }
      ]
    },
    {
      "type": "header",
      "content": "Behavior"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Multiple messages",
      "default": "all",
      "options": [
        { "value": "all", "label": "Show all at once" },
        { "value": "rotate", "label": "Rotate one at a time" }
      ],
      "info": "Only matters with more than one message."
    },
    {
      "type": "range",
      "id": "rotation_speed",
      "min": 3,
      "max": 15,
      "step": 1,
      "unit": "s",
      "label": "Rotation speed",
      "default": 5
    },
    {
      "type": "checkbox",
      "id": "show_dismiss",
      "label": "Let visitors dismiss the bar",
      "default": false,
      "info": "Stays dismissed for the rest of the visitor's session."
    },
    {
      "type": "checkbox",
      "id": "show_localization",
      "label": "Show country and language selector",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "none",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "truck", "label": "Delivery" },
            { "value": "shield", "label": "Warranty" },
            { "value": "plug", "label": "Power" },
            { "value": "refresh", "label": "Returns" },
            { "value": "support", "label": "Support" },
            { "value": "globe", "label": "Global" }
          ]
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Free express shipping on orders over 200"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "countries",
          "label": "Show for countries",
          "info": "Comma-separated ISO country codes, for example US, CA, GB. Leave blank to show in every market."
        },
        {
          "type": "header",
          "content": "Text style"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text color",
          "info": "Leave blank to use the section's text color."
        },
        {
          "type": "select",
          "id": "text_size",
          "label": "Text size",
          "default": "default",
          "options": [
            { "value": "default", "label": "Default" },
            { "value": "small", "label": "Small" },
            { "value": "large", "label": "Large" },
            { "value": "xlarge", "label": "Extra large" }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement bar",
      "blocks": [{ "type": "announcement" }]
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  }
}
{% endschema %}
