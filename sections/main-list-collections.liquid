{{ 'component-card.css' | asset_url | stylesheet_tag }}

<div class="list-collections section-padding section-frame" style="{% render 'section-style' %}">
  <div class="page-width">
    <h1 class="h2">{{ page_title }}</h1>

    <ul class="grid" role="list" style="--columns-desktop: {{ section.settings.columns_desktop }}; --columns-mobile: 2;">
      {%- for collection in collections -%}
        <li class="grid__item">
          <div class="card card--collection">
            <a href="{{ collection.url }}" class="card__media" tabindex="-1" aria-hidden="true">
              {%- if collection.featured_image -%}
                {% render 'responsive-image',
                  image: collection.featured_image,
                  sizes: '(min-width: 990px) 25vw, 50vw',
                  class: 'card__image'
                %}
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag: 'card__image placeholder-svg' }}
              {%- endif -%}
            </a>
            <div class="card__content">
              <h2 class="card__heading h5">
                <a href="{{ collection.url }}" class="card__title-link">{{ collection.title | escape }}</a>
              </h2>
              {%- if section.settings.show_product_count -%}
                <p class="caption">
                  {{- 'products.facets.product_count_simple' | t: count: collection.all_products_count -}}
                </p>
              {%- endif -%}
            </div>
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Collections list",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Section style"
    },
    {
      "type": "color",
      "id": "section_background",
      "label": "Background color",
      "info": "Leave blank to use the color scheme background."
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top margin",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom margin",
      "default": 0
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "default": "page",
      "options": [
        {
          "value": "page",
          "label": "Contained"
        },
        {
          "value": "wide",
          "label": "Wide"
        },
        {
          "value": "full",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "range",
      "id": "section_min_height",
      "min": 0,
      "max": 800,
      "step": 20,
      "unit": "px",
      "label": "Minimum height",
      "default": 0,
      "info": "0 uses the content's natural height."
    },
    {
      "type": "range",
      "id": "section_corner_radius",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Corner radius",
      "default": 0
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Columns on desktop",
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_product_count",
      "label": "Show product count",
      "default": true
    }
  ]
}
{% endschema %}
