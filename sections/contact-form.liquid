<div class="contact-section section-padding section-frame" style="{% render 'section-style' %}">
  <div class="page-width page-width--narrow">
    {%- if section.settings.heading != blank -%}
      <h2 class="h3">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- form 'contact', class: 'contact-form' -%}
      {%- if form.posted_successfully? -%}
        <p class="form__message form__message--success" role="status">
          {{- 'sections.contact_form.post_success' | t -}}
        </p>
      {%- elsif form.errors -%}
        <div class="form__message" role="alert">
          <h3 class="h6">{{ 'sections.contact_form.error_heading' | t }}</h3>
          <ul role="list">
            {%- for field in form.errors -%}
              <li>{{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}</li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}

      <div class="contact-form__grid">
        <div class="field">
          <label class="form__label" for="ContactName">{{ 'sections.contact_form.name' | t }}</label>
          <input class="input" type="text" id="ContactName" name="contact[name]" value="{{ form.name }}" autocomplete="name">
        </div>

        <div class="field">
          <label class="form__label" for="ContactEmail">{{ 'sections.contact_form.email' | t }}</label>
          <input
            class="input"
            type="email"
            id="ContactEmail"
            name="contact[email]"
            value="{{ form.email }}"
            autocomplete="email"
            required
            {% if form.errors contains 'email' %}aria-invalid="true"{% endif %}
          >
        </div>

        <div class="field">
          <label class="form__label" for="ContactPhone">{{ 'sections.contact_form.phone' | t }}</label>
          <input class="input" type="tel" id="ContactPhone" name="contact[phone]" value="{{ form.phone }}" autocomplete="tel">
        </div>

        <div class="field field--full">
          <label class="form__label" for="ContactBody">{{ 'sections.contact_form.comment' | t }}</label>
          <textarea class="input" id="ContactBody" name="contact[body]" rows="6" required>{{ form.body }}</textarea>
        </div>
      </div>

      <button type="submit" class="button button--primary">{{ 'sections.contact_form.send' | t }}</button>
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Contact form",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Section style"
    },
    {
      "type": "color",
      "id": "section_background",
      "label": "Background color",
      "info": "Leave blank to use the color scheme background."
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top margin",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom margin",
      "default": 0
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "default": "page",
      "options": [
        {
          "value": "page",
          "label": "Contained"
        },
        {
          "value": "wide",
          "label": "Wide"
        },
        {
          "value": "full",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "range",
      "id": "section_min_height",
      "min": 0,
      "max": 800,
      "step": 20,
      "unit": "px",
      "label": "Minimum height",
      "default": 0,
      "info": "0 uses the content's natural height."
    },
    {
      "type": "range",
      "id": "section_corner_radius",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Corner radius",
      "default": 0
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Contact us"
    }
  ],
  "presets": [
    {
      "name": "Contact form"
    }
  ]
}
{% endschema %}
