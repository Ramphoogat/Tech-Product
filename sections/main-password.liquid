<div class="password section-padding section-frame" style="{% render 'section-style' %}">
  <div class="page-width page-width--narrow password__inner">
    {%- if settings.logo != blank -%}
      {% render 'responsive-image',
        image: settings.logo,
        sizes: '160px',
        widths: '160,320,480',
        loading: 'eager',
        class: 'password__logo',
        alt_override: shop.name
      %}
    {%- else -%}
      {% render 'logo-mark' %}
    {%- endif -%}

    <h2 class="h3">{{ section.settings.heading | default: shop.name }}</h2>

    {%- if section.settings.content != blank -%}
      <div class="rte">{{ section.settings.content }}</div>
    {%- endif -%}

    {%- form 'customer', class: 'newsletter-form' -%}
      <input type="hidden" name="contact[tags]" value="prospect, password page">
      <label class="visually-hidden" for="PasswordNewsletter">
        {{- 'general.newsletter_form.email_label' | t -}}
      </label>
      <div class="newsletter-form__field">
        <input
          id="PasswordNewsletter"
          class="input"
          type="email"
          name="contact[email]"
          value="{{ form.email }}"
          autocomplete="email"
          required
          placeholder="{{ 'general.newsletter_form.email_placeholder' | t | escape }}"
        >
        <button type="submit" class="button button--primary">
          {{- 'general.newsletter_form.button_label' | t -}}
        </button>
      </div>
      {%- if form.posted_successfully? -%}
        <p class="form__message form__message--success" role="status">
          {{- 'general.newsletter_form.success' | t -}}
        </p>
      {%- endif -%}
    {%- endform -%}

    <details class="password__login">
      <summary class="link">{{ 'general.password_page.login_form_heading' | t }}</summary>
      {%- form 'storefront_password', class: 'password__form' -%}
        <label class="form__label" for="StorefrontPassword">
          {{- 'general.password_page.login_form_password_label' | t -}}
        </label>
        <div class="newsletter-form__field">
          <input
            type="password"
            id="StorefrontPassword"
            class="input"
            name="password"
            autocomplete="current-password"
            placeholder="{{ 'general.password_page.login_form_password_placeholder' | t | escape }}"
            {% if form.errors %}aria-invalid="true" aria-describedby="StorefrontPasswordError"{% endif %}
          >
          <button type="submit" class="button button--primary">
            {{- 'general.password_page.login_form_submit' | t -}}
          </button>
        </div>
        {%- if form.errors -%}
          <p class="form__message" id="StorefrontPasswordError" role="alert">
            {{- 'general.password_page.login_form_error' | t -}}
          </p>
        {%- endif -%}
      {%- endform -%}
    </details>

    <p class="caption">{{ 'general.password_page.admin_link_html' | t }}</p>
  </div>
</div>

{% schema %}
{
  "name": "Password page",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Section style"
    },
    {
      "type": "color",
      "id": "section_background",
      "label": "Background color",
      "info": "Leave blank to use the color scheme background."
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top margin",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom margin",
      "default": 0
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "default": "page",
      "options": [
        {
          "value": "page",
          "label": "Contained"
        },
        {
          "value": "wide",
          "label": "Wide"
        },
        {
          "value": "full",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "range",
      "id": "section_min_height",
      "min": 0,
      "max": 800,
      "step": 20,
      "unit": "px",
      "label": "Minimum height",
      "default": 0,
      "info": "0 uses the content's natural height."
    },
    {
      "type": "range",
      "id": "section_corner_radius",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Corner radius",
      "default": 0
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Opening soon"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content",
      "default": "<p>Be the first to know when we launch.</p>"
    }
  ]
}
{% endschema %}
