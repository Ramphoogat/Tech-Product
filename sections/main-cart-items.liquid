{{ 'component-cart.css' | asset_url | stylesheet_tag }}
<script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>

<div class="cart-page section-padding section-frame" style="{% render 'section-style' %}">
  <div class="page-width">
    <h1 class="cart-page__title h2">{{ 'sections.cart.title' | t }}</h1>

    {%- if cart == empty -%}
      <div class="cart-page__empty">
        <p class="h4">{{ 'sections.cart.empty' | t }}</p>
        <p>{{ 'sections.cart.empty_text' | t }}</p>
        <a href="{{ routes.all_products_collection_url }}" class="button button--primary">
          {{- 'general.continue_shopping' | t -}}
        </a>
      </div>
    {%- else -%}
      <cart-items class="cart-page__items">
        <form action="{{ routes.cart_url }}" method="post" id="CartPageForm" class="cart-page__form" novalidate>
          <table class="cart-table">
            <caption class="visually-hidden">{{ 'sections.cart.title' | t }}</caption>
            <thead>
              <tr>
                <th scope="col" colspan="2">{{ 'sections.cart.headings.product' | t }}</th>
                <th scope="col">{{ 'sections.cart.headings.price' | t }}</th>
                <th scope="col">{{ 'sections.cart.headings.quantity' | t }}</th>
                <th scope="col" class="cart-table__right">{{ 'sections.cart.headings.total' | t }}</th>
              </tr>
            </thead>
            <tbody>
              {%- for item in cart.items -%}
                <tr class="cart-row" data-key="{{ item.key }}" data-line="{{ forloop.index }}">
                  <td class="cart-row__media">
                    <a href="{{ item.url }}" tabindex="-1" aria-hidden="true">
                      {%- if item.image -%}
                        {% render 'responsive-image',
                          image: item.image,
                          sizes: '110px',
                          widths: '110,220,330',
                          class: 'cart-row__image'
                        %}
                      {%- endif -%}
                    </a>
                  </td>

                  <td class="cart-row__details">
                    <a href="{{ item.url }}" class="cart-row__title">{{ item.product.title | escape }}</a>

                    {%- if settings.cart_show_vendor and item.product.vendor != blank -%}
                      <p class="caption">{{ item.product.vendor }}</p>
                    {%- endif -%}

                    {%- unless item.product.has_only_default_variant -%}
                      <p class="caption">
                        {%- for option in item.options_with_values -%}
                          {{ option.name }}: {{ option.value }}{% unless forloop.last %} · {% endunless %}
                        {%- endfor -%}
                      </p>
                    {%- endunless -%}

                    {%- if item.selling_plan_allocation -%}
                      <p class="caption">{{ item.selling_plan_allocation.selling_plan.name }}</p>
                    {%- endif -%}

                    {%- if item.line_level_discount_allocations.size > 0 -%}
                      <ul class="caption" role="list">
                        {%- for allocation in item.line_level_discount_allocations -%}
                          <li>{{ allocation.discount_application.title }} (-{{ allocation.amount | money }})</li>
                        {%- endfor -%}
                      </ul>
                    {%- endif -%}

                    <p class="cart-item__error caption" role="alert" data-line-error hidden></p>
                  </td>

                  <td class="cart-row__price">
                    {%- if item.original_price != item.final_price -%}
                      <s class="caption">{{ item.original_price | money }}</s>
                      <span>{{ item.final_price | money }}</span>
                    {%- else -%}
                      <span>{{ item.final_price | money }}</span>
                    {%- endif -%}
                  </td>

                  <td class="cart-row__quantity">
                    {% render 'quantity-input',
                      id: 'CartQuantity-' | append: forloop.index,
                      name: 'updates[]',
                      value: item.quantity,
                      min: 0,
                      product_title: item.product.title,
                      line_index: forloop.index
                    %}
                    <a
                      href="{{ item.url_to_remove }}"
                      class="cart-item__remove link"
                      data-line="{{ forloop.index }}"
                      aria-label="{{ 'sections.cart.remove_title' | t: title: item.title | escape }}"
                    >
                      {{- 'general.accessibility.remove' | t -}}
                    </a>
                  </td>

                  <td class="cart-row__total cart-table__right">
                    {{ item.final_line_price | money }}
                  </td>
                </tr>
              {%- endfor -%}
            </tbody>
          </table>

          <noscript>
            <button type="submit" name="update" class="button button--secondary">
              {{- 'sections.cart.update' | t -}}
            </button>
          </noscript>
        </form>
      </cart-items>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Cart items",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Section style"
    },
    {
      "type": "color",
      "id": "section_background",
      "label": "Background color",
      "info": "Leave blank to use the color scheme background."
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top margin",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom margin",
      "default": 0
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "default": "page",
      "options": [
        {
          "value": "page",
          "label": "Contained"
        },
        {
          "value": "wide",
          "label": "Wide"
        },
        {
          "value": "full",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "range",
      "id": "section_min_height",
      "min": 0,
      "max": 800,
      "step": 20,
      "unit": "px",
      "label": "Minimum height",
      "default": 0,
      "info": "0 uses the content's natural height."
    },
    {
      "type": "range",
      "id": "section_corner_radius",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Corner radius",
      "default": 0
    }
  ]
}
{% endschema %}
