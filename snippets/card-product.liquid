{%- comment -%}
  Product card.
  Accepts: product, sizes, image_loading, show_vendor, show_compare, index.
{%- endcomment -%}

{%- liquid
  assign sizes = sizes | default: '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 50vw'
  assign image_loading = image_loading | default: 'lazy'
  assign ratio = settings.card_image_ratio

  case ratio
    when 'square'
      assign ratio_value = '1 / 1'
    when 'portrait'
      assign ratio_value = '3 / 4'
    when 'landscape'
      assign ratio_value = '4 / 3'
    else
      assign ratio_value = product.featured_media.aspect_ratio | default: 1
  endcase

  assign second_media = product.media[1]
  assign on_sale = false
  if product.compare_at_price > product.price
    assign on_sale = true
  endif
-%}

<div class="card-wrapper" data-product-handle="{{ product.handle }}">
  <div class="card card--product">
    <div class="card__media" style="--card-ratio: {{ ratio_value }};">
      {%- if product.featured_media -%}
        {% render 'responsive-image',
          image: product.featured_media.preview_image,
          sizes: sizes,
          loading: image_loading,
          class: 'card__image card__image--primary'
        %}
        {%- if settings.card_show_second_image and second_media -%}
          {% render 'responsive-image',
            image: second_media.preview_image,
            sizes: sizes,
            loading: 'lazy',
            class: 'card__image card__image--secondary'
          %}
        {%- endif -%}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'card__image placeholder-svg' }}
      {%- endif -%}

      {%- if settings.card_show_badges -%}
        <div class="card__badges">
          {%- unless product.available -%}
            <span class="badge badge--sold-out">{{ 'products.product.sold_out_badge' | t }}</span>
          {%- else -%}
            {%- if on_sale -%}
              <span class="badge badge--sale">{{ 'products.product.on_sale' | t }}</span>
            {%- endif -%}
          {%- endunless -%}
        </div>
      {%- endif -%}
    </div>

    <div class="card__content">
      {%- if settings.card_show_vendor and product.vendor != blank -%}
        <p class="card__vendor caption">{{ product.vendor }}</p>
      {%- endif -%}

      <h3 class="card__heading">
        <a href="{{ product.url }}" class="card__title-link">{{ product.title | escape }}</a>
      </h3>

      {% render 'price', product: product %}

      {%- if settings.card_show_swatches -%}
        {%- for option in product.options_with_values -%}
          {%- liquid
            assign has_swatch = false
            for value in option.values
              if value.swatch != blank
                assign has_swatch = true
                break
              endif
            endfor
          -%}
          {%- if has_swatch -%}
            <ul class="card__swatches" role="list" aria-label="{{ option.name | escape }}">
              {%- for value in option.values limit: 5 -%}
                <li>
                  <span
                    class="swatch swatch--small"
                    title="{{ value.name | escape }}"
                    style="
                      {%- if value.swatch.image -%}
                        --swatch-background: url({{ value.swatch.image | image_url: width: 60 }});
                      {%- else -%}
                        --swatch-background: {{ value.swatch.color | default: '#cccccc' }};
                      {%- endif -%}
                    "
                  ></span>
                </li>
              {%- endfor -%}
              {%- if option.values.size > 5 -%}
                <li class="card__swatches-more caption">+{{ option.values.size | minus: 5 }}</li>
              {%- endif -%}
            </ul>
            {%- break -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}

      {%- if show_compare and settings.enable_compare -%}
        {% render 'compare-toggle', product: product %}
      {%- endif -%}
    </div>
  </div>
</div>
