{%- comment -%}
  Renders an inline SVG icon.
  Usage: {% render 'icon', icon: 'cart' %}
  Every icon inherits currentColor and is hidden from assistive tech; the
  surrounding control is responsible for its own accessible name.
{%- endcomment -%}

{%- liquid
  assign stroke_icons = 'menu,close,search,cart,account,chevron-down,chevron-up,chevron-left,chevron-right,plus,minus,check,arrow-right,filter,compare,globe,truck,shield,plug,refresh,support,play,trash,external,info,alert,sort,zoom'
  assign stroke_list = stroke_icons | split: ','
-%}

{%- if stroke_list contains icon -%}
  <svg class="icon icon-{{ icon }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    {%- case icon -%}
      {%- when 'menu' -%}
        <path d="M3 6h18M3 12h18M3 18h18"/>
      {%- when 'close' -%}
        <path d="M6 6l12 12M18 6L6 18"/>
      {%- when 'search' -%}
        <circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/>
      {%- when 'cart' -%}
        <path d="M3 4h2.2l2.2 11.2a2 2 0 0 0 2 1.6h7.9a2 2 0 0 0 2-1.55L20.5 8H6"/><circle cx="10" cy="20" r="1.3"/><circle cx="17.5" cy="20" r="1.3"/>
      {%- when 'account' -%}
        <circle cx="12" cy="8" r="4"/><path d="M4.5 20a7.5 7.5 0 0 1 15 0"/>
      {%- when 'chevron-down' -%}
        <path d="M6 9.5l6 6 6-6"/>
      {%- when 'chevron-up' -%}
        <path d="M6 14.5l6-6 6 6"/>
      {%- when 'chevron-left' -%}
        <path d="M14.5 6l-6 6 6 6"/>
      {%- when 'chevron-right' -%}
        <path d="M9.5 6l6 6-6 6"/>
      {%- when 'plus' -%}
        <path d="M12 5v14M5 12h14"/>
      {%- when 'minus' -%}
        <path d="M5 12h14"/>
      {%- when 'check' -%}
        <path d="M4.5 12.5l5 5 10-11"/>
      {%- when 'arrow-right' -%}
        <path d="M4 12h15M13 6l6 6-6 6"/>
      {%- when 'filter' -%}
        <path d="M3 6h18M6 12h12M10 18h4"/>
      {%- when 'sort' -%}
        <path d="M7 4v16M7 20l-3-3M7 20l3-3M17 20V4M17 4l-3 3M17 4l3 3"/>
      {%- when 'compare' -%}
        <path d="M9 4H4v16h5zM20 4h-5v16h5z"/><path d="M12 7v10"/>
      {%- when 'globe' -%}
        <circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a15 15 0 0 1 0 18a15 15 0 0 1 0-18z"/>
      {%- when 'truck' -%}
        <path d="M2 6h11v10H2zM13 9h4.5l2.5 3v4h-7z"/><circle cx="6" cy="18.5" r="1.6"/><circle cx="17" cy="18.5" r="1.6"/>
      {%- when 'shield' -%}
        <path d="M12 3l7 3v5.5c0 4.3-2.9 7.9-7 9.5-4.1-1.6-7-5.2-7-9.5V6z"/><path d="M9 12l2 2 4-4"/>
      {%- when 'plug' -%}
        <path d="M9 3v5M15 3v5M6.5 8h11v3a5.5 5.5 0 0 1-11 0z"/><path d="M12 16.5V21"/>
      {%- when 'refresh' -%}
        <path d="M20 11a8 8 0 1 0-.9 4.6"/><path d="M20 5v6h-6"/>
      {%- when 'support' -%}
        <path d="M4 13v-1a8 8 0 0 1 16 0v1"/><path d="M4 13h3v5H5.5A1.5 1.5 0 0 1 4 16.5zM20 13h-3v5h1.5a1.5 1.5 0 0 0 1.5-1.5z"/>
      {%- when 'play' -%}
        <circle cx="12" cy="12" r="9"/><path d="M10 8.5l6 3.5-6 3.5z"/>
      {%- when 'trash' -%}
        <path d="M4 7h16M9 7V4.5h6V7M6.5 7l1 13h9l1-13"/>
      {%- when 'external' -%}
        <path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/>
      {%- when 'info' -%}
        <circle cx="12" cy="12" r="9"/><path d="M12 11v6M12 7.6v.6"/>
      {%- when 'alert' -%}
        <path d="M12 4l9 16H3z"/><path d="M12 10v4M12 17.2v.4"/>
      {%- when 'zoom' -%}
        <circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5M8.5 11h5M11 8.5v5"/>
    {%- endcase -%}
  </svg>
{%- else -%}
  <svg class="icon icon-{{ icon }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
    {%- case icon -%}
      {%- when 'instagram' -%}
        <path d="M12 2.2c3.2 0 3.6 0 4.9.07 1.2.05 1.8.25 2.2.42.6.22 1 .48 1.4.9.4.4.7.8.9 1.4.2.4.4 1 .4 2.2.1 1.3.1 1.7.1 4.9s0 3.6-.1 4.9c0 1.2-.2 1.8-.4 2.2-.2.6-.5 1-.9 1.4-.4.4-.8.7-1.4.9-.4.2-1 .4-2.2.4-1.3.1-1.7.1-4.9.1s-3.6 0-4.9-.1c-1.2 0-1.8-.2-2.2-.4-.6-.2-1-.5-1.4-.9-.4-.4-.7-.8-.9-1.4-.2-.4-.4-1-.4-2.2C2.2 15.6 2.2 15.2 2.2 12s0-3.6.07-4.9c.05-1.2.25-1.8.42-2.2.22-.6.48-1 .9-1.4.4-.4.8-.7 1.4-.9.4-.2 1-.4 2.2-.4C8.4 2.2 8.8 2.2 12 2.2m0 1.8c-3.1 0-3.5 0-4.8.07-1.1.05-1.7.24-2.1.4-.5.2-.9.44-1.3.84-.4.4-.64.8-.84 1.3-.16.4-.35 1-.4 2.1C2.5 8.5 2.5 8.9 2.5 12s0 3.5.06 4.8c.05 1.1.24 1.7.4 2.1.2.5.44.9.84 1.3.4.4.8.64 1.3.84.4.16 1 .35 2.1.4 1.3.06 1.7.06 4.8.06s3.5 0 4.8-.06c1.1-.05 1.7-.24 2.1-.4.5-.2.9-.44 1.3-.84.4-.4.64-.8.84-1.3.16-.4.35-1 .4-2.1.06-1.3.06-1.7.06-4.8s0-3.5-.06-4.8c-.05-1.1-.24-1.7-.4-2.1a3.5 3.5 0 0 0-.84-1.3 3.5 3.5 0 0 0-1.3-.84c-.4-.16-1-.35-2.1-.4C15.5 4 15.1 4 12 4m0 3a5 5 0 1 1 0 10 5 5 0 0 1 0-10m0 1.8a3.2 3.2 0 1 0 0 6.4 3.2 3.2 0 0 0 0-6.4M17.4 5.6a1.2 1.2 0 1 1 0 2.4 1.2 1.2 0 0 1 0-2.4"/>
      {%- when 'youtube' -%}
        <path d="M22.5 7.2a2.8 2.8 0 0 0-2-2C18.8 4.8 12 4.8 12 4.8s-6.8 0-8.5.4a2.8 2.8 0 0 0-2 2C1.2 8.9 1.2 12 1.2 12s0 3.1.3 4.8a2.8 2.8 0 0 0 2 2c1.7.4 8.5.4 8.5.4s6.8 0 8.5-.4a2.8 2.8 0 0 0 2-2c.3-1.7.3-4.8.3-4.8s0-3.1-.3-4.8M9.9 15.3V8.7l5.6 3.3z"/>
      {%- when 'facebook' -%}
        <path d="M22 12a10 10 0 1 0-11.6 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.4h-1.2c-1.2 0-1.6.8-1.6 1.6V12h2.7l-.4 2.9h-2.3v7A10 10 0 0 0 22 12"/>
      {%- when 'x' -%}
        <path d="M17.5 3h3.1l-6.8 7.8L21.8 21h-6.2l-4.9-6.4L5 21H1.9l7.3-8.3L2.4 3h6.4l4.4 5.8zm-1.1 16.1h1.7L7.7 4.8H5.9z"/>
      {%- when 'linkedin' -%}
        <path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5M3 9.5h4V21H3zM9.5 9.5h3.8v1.6h.05c.53-.95 1.83-1.95 3.75-1.95 4 0 4.75 2.5 4.75 5.8V21h-4v-5.3c0-1.27-.02-2.9-1.8-2.9-1.8 0-2.07 1.38-2.07 2.8V21h-4z"/>
      {%- when 'check-circle' -%}
        <path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20m-1.2 14.4-4-4 1.4-1.4 2.6 2.6 5.6-5.6 1.4 1.4z"/>
    {%- endcase -%}
  </svg>
{%- endif -%}
