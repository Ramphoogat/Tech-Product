{%- comment -%}
  One market-dependent information row (delivery, warranty, power standard...).

  Visibility is decided against localization.country.iso_code, which is the
  country of the active market, so a shopper in Germany and a shopper in Japan
  can be shown different delivery and warranty terms from the same theme.

  The body copy comes from the block by default. If the block names a product
  metafield in the `market_info` namespace and that metafield has a value on
  this product, the metafield wins — that is the per-product override.

  Accepts: block, product.
{%- endcomment -%}

{%- liquid
  assign codes = block.settings.countries | remove: ' ' | upcase | split: ','
  assign visible = false
  if block.settings.countries == blank
    assign visible = true
  elsif codes contains localization.country.iso_code
    assign visible = true
  endif

  assign body = block.settings.content
  assign key = block.settings.metafield_key
  if key != blank and key != 'none'
    assign override = product.metafields.market_info[key]
    if override != blank and override.value != blank
      assign body = override.value
    endif
  endif
-%}

{%- if visible and body != blank -%}
  <details
    class="accordion market-info"
    {% if block.settings.open_by_default %}open{% endif %}
    {{ block.shopify_attributes }}
  >
    <summary class="accordion__summary">
      <span class="accordion__title">
        {%- if block.settings.icon != 'none' -%}
          {% render 'icon', icon: block.settings.icon %}
        {%- endif -%}
        {{ block.settings.heading }}
      </span>
      <span class="accordion__marker" aria-hidden="true">{% render 'icon', icon: 'chevron-down' %}</span>
    </summary>
    <div class="accordion__content rte">{{ body }}</div>
  </details>
{%- endif -%}
