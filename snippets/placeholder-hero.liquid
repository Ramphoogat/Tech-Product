{%- comment -%}
  Decorative circuit-board placeholder graphic for the image banner when no
  image has been picked yet, so a fresh theme preview shows a finished-looking
  hero instead of an empty color block. Purely presentational: aria-hidden.
{%- endcomment -%}

<svg
  class="placeholder-hero"
  viewBox="0 0 1600 900"
  preserveAspectRatio="xMidYMid slice"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  focusable="false"
>
  <rect width="1600" height="900" fill="currentColor" opacity="0.06"/>
  <g fill="none" stroke="currentColor" stroke-width="2" opacity="0.35">
    <path d="M-40 200H520v160h360v260h760"/>
    <path d="M-40 700h300v-180h420V220h300v-260h660"/>
    <path d="M1640 120H1180v220H860v340H420v160H-40"/>
  </g>
  <g fill="currentColor" opacity="0.5">
    <circle cx="520" cy="200" r="7"/>
    <circle cx="880" cy="360" r="7"/>
    <circle cx="880" cy="620" r="7"/>
    <circle cx="1640" cy="620" r="7"/>
    <circle cx="260" cy="700" r="7"/>
    <circle cx="680" cy="520" r="7"/>
    <circle cx="1180" cy="340" r="7"/>
    <circle cx="1480" cy="120" r="7"/>
  </g>
</svg>
