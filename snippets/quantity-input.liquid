{%- comment -%}
  Accessible number stepper.
  Accepts: id, name, value, min, max, step, product_title, form_id, line_index.
{%- endcomment -%}

{%- liquid
  assign name = name | default: 'quantity'
  assign value = value | default: 1
  assign min = min | default: 1
  assign step = step | default: 1
-%}

<quantity-input class="quantity" data-line="{{ line_index }}">
  <button
    type="button"
    class="quantity__button"
    name="minus"
    aria-label="{{ 'products.product.quantity.decrease' | t: product: product_title | escape }}"
  >
    {% render 'icon', icon: 'minus' %}
  </button>

  <input
    class="quantity__input"
    type="number"
    id="{{ id }}"
    name="{{ name }}"
    value="{{ value }}"
    min="{{ min }}"
    {% if max %}max="{{ max }}"{% endif %}
    step="{{ step }}"
    inputmode="numeric"
    autocomplete="off"
    aria-label="{{ 'products.product.quantity.input_label' | t: product: product_title | escape }}"
    {% if form_id %}form="{{ form_id }}"{% endif %}
  >

  <button
    type="button"
    class="quantity__button"
    name="plus"
    aria-label="{{ 'products.product.quantity.increase' | t: product: product_title | escape }}"
  >
    {% render 'icon', icon: 'plus' %}
  </button>
</quantity-input>
